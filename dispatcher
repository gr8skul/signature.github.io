<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Signature Dispatch</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --background: #f4f5f7;
      --surface: #ffffff;
      --border: #dfe2e6;
      --text: #202326;
      --muted: #6b7075;
      --accent: #222;
      --danger: #a52a2a;
    }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    /* =========================================
       HEADER
       ========================================= */

    header {
      height: 68px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: baseline;
      gap: 12px;
    }

    .brand-name {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .brand-section {
      color: var(--muted);
      font-size: 14px;
    }

    .user-area {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .user-info {
      text-align: right;
    }

    .user-name {
      font-size: 14px;
      font-weight: 600;
    }

    .user-role {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
      text-transform: capitalize;
    }

    .sign-out {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 8px 12px;
      color: var(--text);
    }

    .sign-out:hover {
      background: #f0f1f2;
    }

    /* =========================================
       LAYOUT
       ========================================= */

    .app {
      display: flex;
      min-height: calc(100vh - 68px);
    }

    nav {
      width: 220px;
      background: #fafafa;
      border-right: 1px solid var(--border);
      padding: 22px 14px;
      flex-shrink: 0;
    }

    .nav-label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      margin: 4px 10px 10px;
      text-transform: uppercase;
    }

    .nav-button {
      width: 100%;
      text-align: left;
      background: transparent;
      border: 0;
      border-radius: 6px;
      padding: 11px 10px;
      margin-bottom: 3px;
      color: var(--text);
    }

    .nav-button:hover,
    .nav-button.active {
      background: #e9eaec;
    }

    main {
      flex: 1;
      padding: 30px;
      max-width: 1500px;
    }

    /* =========================================
       PAGE HEAD
       ========================================= */

    .page-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
    }

    .page-head h1 {
      margin: 0;
      font-size: 28px;
    }

    .page-head p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    .primary {
      background: var(--accent);
      color: white;
      border: 0;
      border-radius: 6px;
      padding: 11px 16px;
      font-weight: 600;
    }

    .primary:hover {
      background: #000;
    }

    /* =========================================
       CARDS
       ========================================= */

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }

    .card-head {
      padding: 16px 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-head h2 {
      margin: 0;
      font-size: 16px;
    }

    .card-body {
      padding: 18px;
    }

    /* =========================================
       SCHEDULE
       ========================================= */

    .date-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .date-controls button {
      background: white;
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 7px 11px;
    }

    .date-controls strong {
      min-width: 190px;
      text-align: center;
      font-size: 15px;
    }

    .schedule-list {
      display: flex;
      flex-direction: column;
    }

    .schedule-item {
      display: grid;
      grid-template-columns: 90px 1fr auto;
      gap: 18px;
      padding: 17px 18px;
      border-bottom: 1px solid #eceef0;
      align-items: center;
    }

    .schedule-item:last-child {
      border-bottom: 0;
    }

    .schedule-time {
      font-size: 14px;
      font-weight: 600;
    }

    .schedule-description {
      font-weight: 600;
      margin-bottom: 5px;
    }

    .schedule-meta {
      color: var(--muted);
      font-size: 13px;
    }

    .status {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 4px;
      background: #eceef0;
      font-size: 11px;
      text-transform: capitalize;
      white-space: nowrap;
    }

    .empty {
      padding: 45px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    /* =========================================
       TABLES
       ========================================= */

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 12px 14px;
      border-bottom: 1px solid #eceef0;
      font-size: 14px;
    }

    th {
      font-size: 12px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .4px;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    /* =========================================
       FORMS
       ========================================= */

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 17px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 7px;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid #cfd3d7;
      border-radius: 5px;
      padding: 10px 11px;
      background: white;
      color: var(--text);
      outline: none;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #555;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 9px;
      margin-top: 20px;
    }

    .secondary {
      background: white;
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 10px 15px;
    }

    /* =========================================
       MESSAGE
       ========================================= */

    #message {
      position: fixed;
      right: 25px;
      bottom: 25px;
      background: #222;
      color: white;
      padding: 13px 17px;
      border-radius: 6px;
      display: none;
      z-index: 50;
      font-size: 14px;
      box-shadow: 0 5px 20px rgba(0,0,0,.15);
    }

    #message.error {
      background: var(--danger);
    }

    /* =========================================
       RESPONSIVE
       ========================================= */

    @media (max-width: 800px) {

      header {
        padding: 0 16px;
      }

      .brand-section,
      .user-role {
        display: none;
      }

      nav {
        width: 175px;
      }

      main {
        padding: 20px;
      }

      .page-head {
        align-items: flex-start;
        flex-direction: column;
      }

      .schedule-item {
        grid-template-columns: 70px 1fr;
      }

      .schedule-item .status {
        display: none;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }
    }

    @media (max-width: 600px) {

      .app {
        display: block;
      }

      nav {
        width: 100%;
        border-right: 0;
        border-bottom: 1px solid var(--border);
        display: flex;
        overflow-x: auto;
        padding: 8px;
      }

      .nav-label {
        display: none;
      }

      .nav-button {
        width: auto;
        white-space: nowrap;
        margin: 0;
      }

      main {
        padding: 16px;
      }
    }
  </style>

</head>

<body>

  <!-- =========================================
       HEADER
       ========================================= -->

  <header>


<div class="brand">
  <div class="brand-name">SIGNATURE</div>
  <div class="brand-section">DISPATCH</div>
</div>

<div class="user-area">

  <div class="user-info">
    <div class="user-name" id="userName">
      Loading...
    </div>

    <div class="user-role" id="userRole">
      Loading...
    </div>
  </div>

  <button class="sign-out" id="signOutButton">
