    Customers
  </button>

  <button
    class="nav-button"
    data-page="locations"
  >
    Locations
  </button>

  <button
    class="nav-button"
    data-page="technicians"
  >
    Technicians
  </button>

  <button
    class="nav-button"
    data-page="parts"
  >
    Parts
  </button>

  <button
    class="nav-button"
