// ============================================
// HTML ESCAPE
// ============================================

function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

}


// ============================================
// START APPLICATION
// ============================================

async function startApp() {

  const loggedIn =
    await requireLogin();


  if (!loggedIn) {
    return;
  }


  const profileLoaded =
    await loadUserProfile();


  if (!profileLoaded) {
    return;
  }


  await showSchedule();

}




