</nav>


<main id="mainContent">
  <div class="empty">
    Loading Dispatch...
  </div>
</main>


  </div>

  <div id="message"></div>

  <script>

    // ============================================
    // SUPABASE
    // ============================================

    const SUPABASE_URL =
      "https://zpawrfdfutswbvhlwvqf.supabase.co";

    const SUPABASE_ANON_KEY =
      "sb_publishable_NGa3aWmkMCXm45Hf4m-RYQ_QitmMq68";

    const { createClient } = supabase;

    const db = createClient(
      SUPABASE_URL,
      SUPABASE_ANON_KEY
    );


    // ============================================
    // GLOBAL STATE
    // ============================================

    let currentUser = null;
    let currentProfile = null;
    let currentDate = new Date();


    // ============================================
    // HELPERS
    // ============================================

    function showMessage(text, error = false) {

      const element =
        document.getElementById("message");

      element.textContent = text;
      element.className = error ? "error" : "";
      element.style.display = "block";

      setTimeout(() => {
        element.style.display = "none";
      }, 3500);
    }


    function formatDate(date) {

      return date.toLocaleDateString(
        "en-US",
        {
          weekday: "long",
          month: "long",
          day: "numeric",
          year: "numeric"
        }
      );

    }


    function dateForDatabase(date) {

      const year =
        date.getFullYear();

      const month =
        String(date.getMonth() + 1).padStart(2, "0");

      const day =
        String(date.getDate()).padStart(2, "0");

      return `${year}-${month}-${day}`;

    }


    // ============================================
    // AUTHENTICATION
    // ============================================

    async function requireLogin() {

      const {
        data: {
          session
        }
      } = await db.auth.getSession();


      if (!session) {

        window.location.href =
          "login.html";

        return false;
      }


      currentUser =
        session.user;

      return true;

    }


    // ============================================
    // LOAD USER PROFILE
    // ============================================

    async function loadUserProfile() {

      const {
        data,
        error
      } = await db
        .from("users")
        .select("*")
        .eq(
          "auth_user_id",
          currentUser.id
        )
        .single();


      if (error) {

        console.error(error);

        showMessage(
          "Unable to load your Signature profile.",
          true
        );

        return false;
      }


      currentProfile =
        data;


      document.getElementById("userName")
        .textContent =
          `${data.first_name} ${data.last_name}`;


      document.getElementById("userRole")
        .textContent =
          data.role;


      return true;

    }


    // ============================================
    // SCHEDULE PAGE
    // ============================================

    async function showSchedule() {

      const main =
        document.getElementById("mainContent");


      main.innerHTML = `

        <div class="page-head">

          <div>
            <h1>Schedule</h1>
            <p>Service calls scheduled for the selected day.</p>
          </div>

          <button
            class="primary"
            id="newServiceCallButton"
          >
            + New Service Call
          </button>

        </div>


        <div class="card">

          <div class="card-head">

            <div class="date-controls">

              <button id="previousDay">
                ‹
              </button>

              <strong id="scheduleDate">
                ${formatDate(currentDate)}
              </strong>

              <button id="nextDay">
                ›
              </button>

              <button id="todayButton">
                Today
              </button>

            </div>

          </div>

          <div
            class="schedule-list"
            id="scheduleList"
          >
            <div class="empty">
              Loading schedule...
            </div>
          </div>

        </div>
      `;


      document.getElementById("previousDay")
        .addEventListener("click", () => {

          currentDate.setDate(
            currentDate.getDate() - 1
          );

          showSchedule();

        });


      document.getElementById("nextDay")
        .addEventListener("click", () => {

          currentDate.setDate(
            currentDate.getDate() + 1
          );

          showSchedule();

        });


      document.getElementById("todayButton")
        .addEventListener("click", () => {

          currentDate =
            new Date();

          showSchedule();

        });


      document.getElementById("newServiceCallButton")
        .addEventListener(
          "click",
          showNewServiceCall
        );


      await loadSchedule();

    }


    async function loadSchedule() {

      const list =
        document.getElementById("scheduleList");


      const start =
        new Date(currentDate);

      start.setHours(0, 0, 0, 0);


      const end =
        new Date(currentDate);

      end.setHours(23, 59, 59, 999);


      const {
        data,
        error
      } = await db
        .from("service_calls")
        .select(`
          *,
          customers (
            first_name,
            last_name,
            company_name
          ),
          locations (
            address,
            city,
            state
          ),
          technicians (
            first_name,
            last_name
          )
        `)
        .gte(
          "scheduled_at",
          start.toISOString()
        )
        .lte(
          "scheduled_at",
          end.toISOString()
        )
        .order(
          "scheduled_at",
          {
            ascending: true
          }
        );


      if (error) {

        console.error(error);

        list.innerHTML = `
          <div class="empty">
            Unable to load the schedule.
          </div>
        `;

        return;
      }


      if (!data || data.length === 0) {

        list.innerHTML = `
          <div class="empty">
            No service calls are scheduled for this day.
          </div>
        `;

        return;
      }


      list.innerHTML =
        data.map(call => {

          const scheduled =
            new Date(call.scheduled_at);


          const customer =
            call.customers;

          const technician =
            call.technicians;

          let customerName =
            "Customer";

          if (customer) {

            if (customer.company_name) {

              customerName =
                customer.company_name;

            } else {

              customerName =
                `${customer.first_name || ""} ${customer.last_name || ""}`
                  .trim();

            }

          }


          const technicianName =
            technician
              ? `${technician.first_name} ${technician.last_name}`
              : "Unassigned";


          return `

            <div class="schedule-item">

              <div class="schedule-time">
                ${scheduled.toLocaleTimeString(
                  "en-US",
                  {
                    hour: "numeric",
                    minute: "2-digit"
                  }
                )}
              </div>

              <div>

                <div class="schedule-description">
                  ${escapeHtml(
                    call.description ||
                    customerName
                  )}
                </div>

                <div class="schedule-meta">
                  ${escapeHtml(customerName)}
                  &nbsp; · &nbsp;
                  ${escapeHtml(technicianName)}
                  &nbsp; · &nbsp;
                  ${escapeHtml(
                    call.priority || "normal"
                  )}
                </div>

              </div>

              <div>
                <span class="status">
                  ${escapeHtml(
                    call.status || "open"
                  )}
                </span>
              </div>

            </div>

          `;

        }).join("");

    }


    // ============================================
    // NEW SERVICE CALL
    // ============================================

    async function showNewServiceCall() {

      const main =
        document.getElementById("mainContent");


      main.innerHTML = `

        <div class="page-head">

          <div>
            <h1>New Service Call</h1>
            <p>Create and schedule a new service call.</p>
          </div>

        </div>


        <div class="card">

          <div class="card-body">

            <form id="serviceCallForm">

              <div class="form-grid">

                <div class="form-group">

                  <label for="customer">
                    Customer
                  </label>

                  <select
                    id="customer"
                    required
                  >
                    <option value="">
                      Loading customers...
                    </option>
                  </select>

                </div>


                <div class="form-group">

                  <label for="location">
                    Location
                  </label>

                  <select
                    id="location"
                    required
                  >
                    <option value="">
                      Select a customer first
                    </option>
                  </select>

                </div>


                <div class="form-group">

                  <label for="technician">
                    Technician
                  </label>

                  <select
                    id="technician"
                  >
                    <option value="">
                      Unassigned
                    </option>
                  </select>

                </div>


                <div class="form-group">

                  <label for="scheduledAt">
                    Scheduled
                  </label>

                  <input
                    type="datetime-local"
                    id="scheduledAt"
                    required
                  >

                </div>


                <div class="form-group">

                  <label for="priority">
                    Priority
                  </label>

                  <select id="priority">

                    <option value="normal">
                      Normal
                    </option>

                    <option value="low">
                      Low
                    </option>

                    <option value="high">
                      High
                    </option>

                    <option value="urgent">
                      Urgent
                    </option>

                  </select>

                </div>


                <div class="form-group">

                  <label for="status">
                    Status
                  </label>

                  <select id="status">

                    <option value="open">
                      Open
                    </option>

                    <option value="scheduled">
                      Scheduled
                    </option>

                    <option value="in_progress">
                      In Progress
                    </option>

                    <option value="completed">
                      Completed
                    </option>

                    <option value="cancelled">
                      Cancelled
                    </option>

                  </select>

                </div>


                <div class="form-group full">

                  <label for="description">
                    Description
                  </label>

                  <textarea
                    id="description"
                    placeholder="Describe the work needed..."
                  ></textarea>

```
            </div>

          </div>


          <div class="form-actions">

            <button
              type="button"
              class="secondary"
              id="cancelServiceCall"
            >
              Cancel
            </button>

            <button
              type="submit"
              class="primary"
            >
              Create Service Call
            </button>

          </div>

        </form>

      </div>

    </div>
  `;


  await loadCustomersForForm();
  await loadTechniciansForForm();


  document.getElementById("customer")
    .addEventListener(
      "change",
      loadLocationsForSelectedCustomer
    );


  document.getElementById("cancelServiceCall")
    .addEventListener(
      "click",
      showSchedule
    );


  document.getElementById("serviceCallForm")
    .addEventListener(
      "submit",
      createServiceCall
    );

}


async function loadCustomersForForm() {

  const select =
    document.getElementById("customer");


  const {
    data,
    error
  } = await db
    .from("customers")
    .select("*")
    .order("last_name");


  if (error) {

    console.error(error);

    select.innerHTML =
      `<option value="">Unable to load customers</option>`;

    return;
  }


  select.innerHTML =
    `<option value="">Select customer</option>`;


  data.forEach(customer => {

    let name =
      customer.company_name ||
      `${customer.first_name || ""} ${customer.last_name || ""}`
        .trim();


    if (!name) {
      name = "Unnamed Customer";
    }


    const option =
      document.createElement("option");

    option.value =
      customer.id;

    option.textContent =
      name;

    select.appendChild(option);

  });

}


async function loadLocationsForSelectedCustomer() {

  const customerId =
    document.getElementById("customer").value;

  const select =
    document.getElementById("location");


  if (!customerId) {

    select.innerHTML =
      `<option value="">Select a customer first</option>`;

    return;
  }


  const {
    data,
    error
  } = await db
    .from("locations")
    .select("*")
    .eq(
      "customer_id",
      customerId
    )
    .order("address");


  if (error) {

    console.error(error);

    select.innerHTML =
      `<option value="">Unable to load locations</option>`;

    return;
  }


  select.innerHTML =
    `<option value="">Select location</option>`;


  data.forEach(location => {

    const option =
      document.createElement("option");

    option.value =
      location.id;

    option.textContent =
      `${location.address}, ${location.city}, ${location.state} ${location.zip || ""}`;

    select.appendChild(option);

  });

}


async function loadTechniciansForForm() {

  const select =
    document.getElementById("technician");


  const {
    data,
    error
  } = await db
    .from("technicians")
    .select("*")
    .eq(
      "active",
      true
    )
    .order("last_name");


  if (error) {

    console.error(error);

    return;
  }


  data.forEach(technician => {

    const option =
      document.createElement("option");

    option.value =
      technician.id;

    option.textContent =
      `${technician.first_name} ${technician.last_name}`;

    select.appendChild(option);

  });

}


async function createServiceCall(event) {

  event.preventDefault();


  const customerId =
    document.getElementById("customer").value;

  const locationId =
    document.getElementById("location").value;

  const technicianId =
    document.getElementById("technician").value ||
    null;

  const scheduledAt =
    document.getElementById("scheduledAt").value;

  const priority =
    document.getElementById("priority").value;

  const status =
    document.getElementById("status").value;

  const description =
    document.getElementById("description").value.trim();


  const { error } =
    await db
      .from("service_calls")
      .insert({
        customer_id: customerId,
        locations_id: locationId,
        assigned_technician_id: technicianId,
        status: status,
        priority: priority,
        description: description,
        scheduled_at:
          new Date(scheduledAt).toISOString()
      });


  if (error) {

    console.error(error);

    showMessage(
      error.message,
      true
    );

    return;
  }


  showMessage(
    "Service call created."
  );


  currentDate =
    new Date(scheduledAt);


  await showSchedule();

}


